# monday personal API token with access to the Solicitudes board and the mirrored boards. Server only.
MONDAY_API_TOKEN=
# Optional: area owners as monday user ids, e.g. {"web":[123],"video":[456]}. Without it the team core in lib/board-config.ts decides.
MONDAY_AREA_OWNERS=
# Random secret in the webhook URL: https://<host>/api/monday/webhook/<secret>  (openssl rand -hex 32)
MONDAY_WEBHOOK_SECRET=

# monday OAuth app (Developers → your app → Basic information). Sign-in for the internal dashboard and Ask AI.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
# 32 byte base64 key that seals the session cookie  (openssl rand -base64 32)
MONDAY_TOKEN_KEY=

# Random token for the shared board link: https://<host>/p/<token>  (openssl rand -hex 16)
PUBLIC_BOARD_TOKEN=

# Vercel Blob store (Storage → Blob → Connect); `vercel env pull` brings it locally. Attachments on new requests.
BLOB_READ_WRITE_TOKEN=

# Optional: Power Automate "When a Teams webhook request is received" URL; new requests are posted to the marketing group.
TEAMS_WEBHOOK_URL=
