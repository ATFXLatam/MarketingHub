# Clerk (dashboard → API keys). Restrict sign-ups to the company domain in Clerk → Restrictions as well.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated email domains allowed to submit. Empty in production means nobody gets in.
ALLOWED_EMAIL_DOMAINS=atfxgm.com

# monday personal API token with access to board 18424308173.
MONDAY_API_TOKEN=
# Optional: area owners as monday user ids, e.g. {"web":[123],"video":[456],"eventos":[789],"diseno":[321]}
MONDAY_AREA_OWNERS=
# Random secret in the webhook URL: https://<host>/api/monday/webhook/<secret>  (openssl rand -hex 32)
MONDAY_WEBHOOK_SECRET=

# Random token for the shared board link: https://<host>/p/<token>  (openssl rand -hex 16)
PUBLIC_BOARD_TOKEN=

# Vercel Blob store (Storage → Blob → Connect); `vercel env pull` brings it locally.
BLOB_READ_WRITE_TOKEN=
